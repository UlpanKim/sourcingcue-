# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Bootpay (라이트페이 정기결제)
BOOTPAY_CLIENT_KEY=
BOOTPAY_SECRET_KEY=

# 1688 Product Data API (optional; first configured wins: tmapi -> rapidapi -> onebound)
# SOURCING_1688_PROVIDER=tmapi|rapidapi|onebound  (optional override)
SOURCING_1688_PROVIDER=
# TMAPI (https://tmapi.top)
TMAPI_API_KEY=
# RapidAPI 1688 product detail API
RAPIDAPI_KEY=
RAPIDAPI_1688_HOST=
RAPIDAPI_1688_PATH=/1688/item_detail
# OneBound (https://open.onebound.cn)
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
